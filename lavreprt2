​/* =========================================================================
​PROBLEM 10: Demonstrating Shared Memory in a Union
​========================================================================= */
union Data {
int i;
float f;
char c;
};
​void runProblem10(void) {
union Data d;
printf("\n=== Problem 10: Demonstrating Shared Memory in a Union ===\n");
printf("Size of union Data = %zu bytes\n\n", sizeof(d));
​d.i = 65;
printf("Assigned integer : i = %d\n", d.i);
​d.f = 3.500000f;
printf("Assigned float   : f = %f\n", d.f);
​d.c = 'A';
printf("Assigned char    : c = %c\n", d.c);
​printf("\nNote: Because all members share the same memory location, assigning a new member overwrites previous values.\n");
}
