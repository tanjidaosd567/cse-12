​/* =========================================================================
​PROBLEM 4: ATM Cash Withdrawal System
​========================================================================= */
int checkBalance(float balance, float amount) {
return balance >= amount;
}
​int validateWithdrawal(float amount) {
return (amount > 0.0f) && (((int)amount) % 500 == 0) && (amount == (float)((int)amount));
}
​float withdrawMoney(float balance, float amount) {
return balance - amount;
}
​void displayTransaction(int status, float withdrawn, float remaining) {
printf("\n");
if (status == 1) {
printf("Transaction Status : Successful\n");
printf("Amount Withdrawn   : Tk %.0f\n", withdrawn);
printf("Remaining Balance  : Tk %.0f\n", remaining);
} else {
printf("Transaction Status : Failed\n");
printf("Amount Withdrawn   : Tk 0\n");
printf("Remaining Balance  : Tk %.0f\n", remaining);
}
}
​void runProblem4(void) {
float balance, amount;
​printf("\n=== Problem 4: ATM Cash Withdrawal System ===\n");
printf("Enter account balance: ");
scanf("%f", &balance);
printf("Enter withdrawal amount: ");
scanf("%f", &amount);
​if (!validateWithdrawal(amount)) {
printf("Invalid amount: Withdrawal must be positive and a multiple of Tk 500.\n");
displayTransaction(0, 0.0f, balance);
return;
}
​if (!checkBalance(balance, amount)) {
printf("Insufficient balance.\n");
displayTransaction(0, 0.0f, balance);
return;
}
​float newBalance = withdrawMoney(balance, amount);
displayTransaction(1, amount, newBalance);
}
​/* =========================================================================
​PROBLEM 5: Recursive Factorial
​========================================================================= */
long long factorial(int n) {
if (n == 0 || n == 1) {
return 1LL;
}
return (long long)n * factorial(n - 1);
}
​void runProblem5(void) {
int n;
printf("\n=== Problem 5: Recursive Factorial ===\n");
printf("Enter a number: ");
scanf("%d", &n);
​if (n < 0) {
printf("Error: Negative numbers are not allowed.\n");
return;
}
​printf("Factorial of %d = %lld\n", n, factorial(n));
}
​/* =========================================================================
​PROBLEM 6: Recursive Fibonacci Series
​========================================================================= */
int fibonacci(int n) {
if (n == 0) return 0;
if (n == 1) return 1;
return fibonacci(n - 1) + fibonacci(n - 2);
}
​void runProblem6(void) {
int n;
printf("\n=== Problem 6: Recursive Fibonacci Series ===\n");
printf("Enter number of terms: ");
scanf("%d", &n);
​if (n <= 0) {
printf("Error: Number of terms must be greater than 0.\n");
return;
}
​printf("Fibonacci series: ");
for (int i = 0; i < n; i++) {
printf("%d", fibonacci(i));
if (i < n - 1) printf(" ");
}
printf("\n");
}
