​/* =========================================================================
​PROBLEM 1: Electricity Bill Calculator
​========================================================================= */
float calculateBill(int units) {
float bill = 0.0f;
if (units <= 100) {
bill = units * 5.0f;
} else if (units <= 200) {
bill = (100 * 5.0f) + ((units - 100) * 6.0f);
} else {
bill = (100 * 5.0f) + (100 * 6.0f) + ((units - 200) * 8.0f);
}
return bill;
}
​float calculateVAT(float bill) {
return bill * 0.05f;
}
​void displayBill(int id, const char name[], int units, float charge, float vat, float total) {
printf("\n------- Electricity Bill -------\n");
printf("Customer ID      : %d\n", id);
printf("Customer Name    : %s\n", name);
printf("Units Consumed   : %d\n", units);
printf("Electricity Charge: Tk %.2f\n", charge);
printf("VAT (5%%)         : Tk %.2f\n", vat);
printf("Final Bill       : Tk %.2f\n", total);
}
​void runProblem1(void) {
int id, units;
char name[100];
​printf("\n=== Problem 1: Electricity Bill Calculator ===\n");
printf("Enter customer ID: ");
scanf("%d", &id);
getchar();
printf("Enter customer name: ");
fgets(name, sizeof(name), stdin);
name[strcspn(name, "\n")] = '\0';
​printf("Enter units consumed: ");
scanf("%d", &units);
​if (units < 0) {
printf("Error: Units consumed cannot be negative.\n");
return;
}
​float charge = calculateBill(units);
float vat = calculateVAT(charge);
float total = charge + vat;
displayBill(id, name, units, charge, vat, total);
}
​/* =========================================================================
​PROBLEM 2: Student Result Processing System
​========================================================================= */
int calculateTotal(const int marks[], int n) {
int sum = 0;
for (int i = 0; i < n; i++) {
sum += marks[i];
}
return sum;
}
​float calculateAverage(int total, int n) {
return (float)total / n;
}
​void calculateGrade(float avg, const int marks[], int n, char grade[], float *gpa, char result[]) {
int failAny = 0;
for (int i = 0; i < n; i++) {
if (marks[i] < 40) {
failAny = 1;
break;
}
}
​if (failAny) {
strcpy(grade, "F");
*gpa = 0.00f;
strcpy(result, "Fail");
return;
}
​if (avg >= 80.0f) {
strcpy(grade, "A+");
*gpa = 4.00f;
} else if (avg >= 70.0f) {
strcpy(grade, "A");
*gpa = 3.50f;
} else if (avg >= 60.0f) {
strcpy(grade, "A-");
*gpa = 3.00f;
} else if (avg >= 50.0f) {
strcpy(grade, "B");
*gpa = 2.50f;
} else if (avg >= 40.0f) {
strcpy(grade, "C");
*gpa = 2.00f;
} else {
strcpy(grade, "F");
*gpa = 0.00f;
}
​if (strcmp(grade, "F") == 0) {
strcpy(result, "Fail");
} else {
strcpy(result, "Pass");
}
}
​void displayResult(const char name[], int id, int total, float avg, const char grade[], float gpa, const char result[]) {
printf("\n------- Student Result -------\n");
printf("Name    : %s\n", name);
printf("ID      : %d\n", id);
printf("Total   : %d\n", total);
printf("Average : %.2f\n", avg);
printf("Grade   : %s\n", grade);
printf("GPA     : %.2f\n", gpa);
printf("Result  : %s\n", result);
}
​void runProblem2(void) {
char name[100], grade[5], result[10];
int id, marks[5];
float gpa = 0.0f;
​printf("\n=== Problem 2: Student Result Processing System ===\n");
getchar();
printf("Enter student name: ");
fgets(name, sizeof(name), stdin);
name[strcspn(name, "\n")] = '\0';
​printf("Enter student ID: ");
scanf("%d", &id);
​printf("Enter marks of 5 subjects: ");
for (int i = 0; i < 5; i++) {
scanf("%d", &marks[i]);
if (marks[i] < 0 || marks[i] > 100) {
printf("Error: Each mark must be between 0 and 100.\n");
return;
}
}
​int total = calculateTotal(marks, 5);
float avg = calculateAverage(total, 5);
calculateGrade(avg, marks, 5, grade, &gpa, result);
displayResult(name, id, total, avg, grade, gpa, result);
}
​/* =========================================================================
​PROBLEM 3: Online Shopping Discount Calculator
​========================================================================= */
float calculateDiscount(float amount) {
if (amount >= 5000.0f) {
return amount * 0.10f;
} else if (amount >= 3000.0f) {
return amount * 0.05f;
} else {
return 0.0f;
}
}
​float calculateFinalAmount(float amount, float discount) {
return amount - discount;
}
​void displayReceipt(const char name[], float amount, float discount, float finalPayable) {
int pct = 0;
if (amount >= 5000.0f) pct = 10;
else if (amount >= 3000.0f) pct = 5;
​printf("\n------- Receipt -------\n");
printf("Customer Name : %s\n", name);
printf("Purchase Amount: Tk %.2f\n", amount);
printf("Discount (%d%%) : Tk %.2f\n", pct, discount);
printf("Final Payable : Tk %.2f\n", finalPayable);
}
​void runProblem3(void) {
char name[100];
float amount;
​printf("\n=== Problem 3: Online Shopping Discount Calculator ===\n");
getchar();
printf("Enter customer name: ");
fgets(name, sizeof(name), stdin);
name[strcspn(name, "\n")] = '\0';
​printf("Enter purchase amount: ");
